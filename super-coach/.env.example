HOST=127.0.0.1
PORT=3210

# true: local mock, no paid API or key needed.
# false: Doubao Responses API, configured below.
USE_MOCK=true
AI_PROVIDER=doubao

# Fill ONLY in a private .env after buying a key. .env is ignored by Git.
# Never put keys in browser code, chat, screenshots or version control.
DOUBAO_API_KEY=
OPENAI_API_KEY=
# Doubao endpoint and model. OPENAI_API_KEY is reserved; no OpenAI adapter yet.
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-2-0-lite-260428

# Exact origin(s), without trailing slash, for a reverse proxy.
# APP_ORIGIN=https://coach.example.com
# During HTTP -> HTTPS migration, allow both exact origins separated by a comma.
# APP_ORIGIN=http://coach.example.com,https://coach.example.com
